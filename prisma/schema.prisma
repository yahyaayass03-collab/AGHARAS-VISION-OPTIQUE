// AGHARAS VISION OPTIQUE — schéma relationnel
// Montants monétaires : entiers en centimes de dirham (1 DH = 100).
// Aucun flottant n'est utilisé pour les totaux autoritatifs.

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ProductType {
  OPTICAL
  SUNGLASSES
  CLIP
  CONTACT_LENS
  ACCESSORY
}

enum Gender {
  FEMME
  HOMME
  MIXTE
  ENFANT
}

enum FrameShape {
  PANTOS
  RONDE
  RECTANGULAIRE
  PAPILLON
  CERCLEE
  PERCEE
  AUTRE
}

enum LensKind {
  SINGLE_VISION
  PROGRESSIVE
  NONE
}

enum OpticalReviewStatus {
  APPROVED
  INCOMPATIBLE
  PENDING_REVIEW
}

enum PrescriptionMethod {
  UPLOAD
  MANUAL
  WHATSAPP
  LATER
}

enum PrescriptionStatus {
  PENDING
  RECEIVED
  VERIFIED
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PRODUCTION
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  CARD_ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OrderEmailKind {
  OWNER_ORDER
  CUSTOMER_CONFIRMATION
}

enum OrderEmailStatus {
  PENDING
  SENDING
  SENT
  DISCARDED
  FAILED
}

enum ShipmentStatus {
  PREPARING
  SHIPPED
  DELIVERED
  RETURNED
}

enum CouponType {
  PERCENT
  FIXED
}

enum InventoryReason {
  INITIAL
  RESTOCK
  SALE
  ADJUSTMENT
  RETURN
  CANCELLATION
}

enum ContactStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique @db.VarChar(254)
  passwordHash String   @db.VarChar(255)
  firstName    String
  lastName     String
  phone        String?
  isActive     Boolean  @default(true)
  roleId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role               Role                @relation(fields: [roleId], references: [id])
  sessions           Session[]
  passwordResets     PasswordResetToken[]
  addresses          Address[]
  orders             Order[]
  prescriptions      Prescription[]      @relation("PrescriptionOwner")
  reviewedPrescriptions Prescription[]   @relation("PrescriptionReviewer")
  wishlistItems      WishlistItem[]
  carts              Cart[]
  auditLogs          AuditLog[]
  inventoryMovements InventoryMovement[]
  orderEvents        OrderStatusHistory[]

  @@index([roleId])
  @@index([createdAt])
}

model Role {
  id           String   @id @default(cuid())
  name         String   @unique
  description  String?
  permissions  Json     @default("[]")
  isSystem     Boolean  @default(false)
  isSuperAdmin Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  users User[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  userAgent String?  @db.Text
  ip        String?  @db.VarChar(45)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String
  firstName  String
  lastName   String
  phone      String
  line1      String   @db.VarChar(250)
  line2      String?  @db.VarChar(250)
  city       String
  postalCode String?
  notes      String?  @db.Text
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  tagline     String?
  description String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Brand {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  imageUrl    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]
}

model Product {
  id             String      @id @default(cuid())
  slug           String      @unique
  name           String
  subtitle       String?
  description    String      @db.Text
  story          String?     @db.Text
  brandId        String
  categoryId     String
  type           ProductType
  gender         Gender      @default(MIXTE)
  material       String?
  shape          FrameShape  @default(AUTRE)
  sku            String      @unique
  priceCents     Int
  compareAtCents Int?
  badge          String?
  isActive       Boolean     @default(true)
  archivedAt     DateTime?
  isFeatured     Boolean     @default(false)
  isNew          Boolean     @default(false)
  isBestseller   Boolean     @default(false)
  lensCompatible Boolean     @default(true)
  weightGrams    Int?
  lensWidthMm    Int?
  bridgeMm       Int?
  templeLengthMm Int?
  lensHeightMm   Int?
  totalWidthMm   Int?
  deliveryNote   String?     @db.VarChar(300)
  metaTitle      String?     @db.VarChar(200)
  metaDescription String?    @db.Text
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  brand      Brand             @relation(fields: [brandId], references: [id])
  category   Category          @relation(fields: [categoryId], references: [id])
  images     ProductImage[]
  variants   ProductVariant[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  wishlist   WishlistItem[]
  opticalRules OpticalCompatibilityRule[]

  @@index([categoryId])
  @@index([brandId])
  @@index([type, isActive])
  @@index([gender])
  @@index([priceCents])
  @@index([isActive, isFeatured])
}

model ProductImage {
  id        String @id @default(cuid())
  productId String
  url       String @db.Text
  alt       String @db.VarChar(300)
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// Owner-managed public catalogue/CMS images only. Kept separate from ordinary
// product queries so image BLOBs are fetched exclusively by the media route.
model PublicMediaObject {
  id        String   @id @db.Char(32)
  mimeType  String   @db.VarChar(32)
  sha256    String   @db.Char(64)
  byteLength Int
  data      Bytes    @db.MediumBlob
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model PublicMediaQuota {
  id        String @id @db.VarChar(32)
  bytesUsed Int    @default(0)
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  sku       String  @unique
  colorName String
  colorHex  String
  priceCents Int?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  product    Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory  InventoryItem?
  movements  InventoryMovement[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  opticalRules OpticalCompatibilityRule[]

  @@unique([productId, colorName])
  @@index([productId])
}

model InventoryItem {
  id                String   @id @default(cuid())
  variantId         String   @unique
  quantity          Int      @default(0)
  lowStockThreshold Int      @default(3)
  updatedAt         DateTime @updatedAt

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
}

model InventoryMovement {
  id        String          @id @default(cuid())
  variantId String
  delta     Int
  reason    InventoryReason
  note      String?
  userId    String?
  createdAt DateTime        @default(now())

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  user    User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
}

model LensType {
  id            String        @id @default(cuid())
  slug          String        @unique
  name          String
  description   String        @db.Text
  kind          LensKind
  priceCents    Int           @default(0)
  productTypes  Json          @default("[\"OPTICAL\"]")
  sortOrder     Int           @default(0)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  opticalRules  OpticalCompatibilityRule[]
}

model LensIndex {
  id           String  @id @default(cuid())
  slug         String  @unique
  name         String
  label        String?
  value        String
  priceCents   Int     @default(0)
  maxAbsSphere Decimal? @db.Decimal(4, 2)
  sortOrder    Int     @default(0)
  isActive     Boolean @default(true)
  opticalRules OpticalCompatibilityRule[]
}

// Une décision porte sur une combinaison exacte, y compris tous les traitements.
// L'absence de décision signifie « en attente » ; aucune donnée historique n'est approuvée automatiquement.
model OpticalCompatibilityRule {
  id            String              @id @default(cuid())
  signature     String              @unique
  productId     String
  variantId     String
  lensTypeId    String
  lensIndexId   String
  treatmentIds  Json                @default("[]")
  status        OpticalReviewStatus @default(PENDING_REVIEW)
  reviewer      String?
  reviewedAt    DateTime?
  evidence      String?             @db.Text
  actorEmail    String              @db.VarChar(254)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  product       Product             @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant       ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Restrict)
  lensType      LensType            @relation(fields: [lensTypeId], references: [id], onDelete: Restrict)
  lensIndex     LensIndex           @relation(fields: [lensIndexId], references: [id], onDelete: Restrict)

  @@index([productId, variantId])
  @@index([status])
}

model LensTreatment {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String
  priceCents  Int     @default(0)
  isDefault   Boolean @default(false)
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)
}

model Prescription {
  id               String             @id @default(cuid())
  userId           String?
  method           PrescriptionMethod
  status           PrescriptionStatus @default(PENDING)
  rightSphere      Decimal?           @db.Decimal(5, 2)
  rightCylinder    Decimal?           @db.Decimal(5, 2)
  rightAxis        Int?
  rightAdd         Decimal?           @db.Decimal(4, 2)
  leftSphere       Decimal?           @db.Decimal(5, 2)
  leftCylinder     Decimal?           @db.Decimal(5, 2)
  leftAxis         Int?
  leftAdd          Decimal?           @db.Decimal(4, 2)
  pupillaryDistance Decimal?          @db.Decimal(4, 1)
  filePath         String?            @db.Text
  originalFileName String?            @db.VarChar(255)
  fileMime         String?            @db.VarChar(100)
  fileSize         Int?
  customerNote     String?            @db.Text
  reviewNote       String?            @db.Text
  reviewedById     String?
  reviewedAt       DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user       User?       @relation("PrescriptionOwner", fields: [userId], references: [id], onDelete: SetNull)
  reviewedBy User?       @relation("PrescriptionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([userId])
  @@index([status])
}

model Cart {
  id         String   @id @default(cuid())
  token      String   @unique
  userId     String?
  couponCode String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  items CartItem[]

  @@index([userId])
}

model CartItem {
  id             String   @id @default(cuid())
  cartId         String
  productId      String
  variantId      String
  quantity       Int      @default(1)
  configKey      String   @default("")
  lensSnapshot   Json?
  prescriptionId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cart         Cart          @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  prescription Prescription?  @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)

  @@unique([cartId, variantId, configKey])
  @@index([cartId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String?
  token     String?
  productId String
  createdAt DateTime @default(now())

  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@unique([token, productId])
  @@index([token])
}

model Order {
  id                String             @id @default(cuid())
  reference         String             @unique
  accessToken       String             @unique
  idempotencyKey    String?            @unique
  userId            String?
  email             String             @db.VarChar(254)
  firstName         String             @db.VarChar(120)
  lastName          String             @db.VarChar(120)
  phone             String             @db.VarChar(30)
  addressLine1      String             @db.VarChar(250)
  addressLine2      String?            @db.VarChar(250)
  city              String
  postalCode        String?
  deliveryNotes     String?            @db.Text
  shippingMethodName String             @db.VarChar(120)
  shippingCents     Int
  subtotalCents     Int
  discountCents     Int                @default(0)
  totalCents        Int
  couponCode        String?
  status            OrderStatus        @default(PENDING)
  paymentMethod     PaymentMethod      @default(CASH_ON_DELIVERY)
  paymentStatus     PaymentStatus      @default(PENDING)
  selectedShippingCode String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user     User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  history  OrderStatusHistory[]
  payments Payment[]
  shipments Shipment[]
  redemption CouponRedemption?
  emailNotifications OrderEmailNotification[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderEmailNotification {
  id             String          @id @default(cuid())
  orderId        String
  kind           OrderEmailKind
  status         OrderEmailStatus @default(PENDING)
  attempts       Int             @default(0)
  lastAttemptAt  DateTime?
  sentAt         DateTime?
  lastErrorCode  String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, kind])
  @@index([status, createdAt])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String?
  variantId      String?
  productName    String
  productSlug    String
  variantName    String?
  sku            String
  imageUrl       String? @db.Text
  unitPriceCents Int
  lensPriceCents Int     @default(0)
  quantity       Int
  lineTotalCents Int
  configuration  Json?
  prescriptionId String?
  createdAt      DateTime @default(now())

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  prescription Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  userId     String?
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  amountCents Int
  reference   String?
  createdAt   DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Shipment {
  id             String         @id @default(cuid())
  orderId        String
  method         String
  carrier        String?
  trackingNumber String?
  status         ShipmentStatus @default(PREPARING)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Coupon {
  id               String     @id @default(cuid())
  code             String     @unique
  description      String?  @db.Text
  type             CouponType
  value            Int
  minSubtotalCents Int        @default(0)
  startsAt         DateTime?
  endsAt           DateTime?
  usageLimit       Int?
  usageCount       Int        @default(0)
  perCustomerLimit Int?
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  redemptions CouponRedemption[]
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  orderId   String   @unique
  email     String
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([email])
}

model ShippingMethod {
  id             String  @id @default(cuid())
  code           String  @unique
  name           String
  description    String  @db.Text
  priceCents     Int     @default(0)
  freeFromCents  Int?
  estimatedDays  String?
  isActive       Boolean @default(true)
  sortOrder      Int     @default(0)
}

model Banner {
  id       String  @id @default(cuid())
  key      String  @unique
  eyebrow  String?
  title    String
  subtitle String?
  imageUrl String?
  ctaLabel String?
  ctaHref  String?
  position String  @default("home")
  isActive Boolean @default(true)
  sortOrder Int    @default(0)
}

model FaqItem {
  id        String  @id @default(cuid())
  question  String  @db.VarChar(240)
  answer    String  @db.Text
  category  String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
}

model ContentPage {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  intro           String?  @db.Text
  body            String   @db.LongText
  metaDescription String?  @db.VarChar(200)
  isPublished     Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

model Store {
  id        String  @id @default(cuid())
  slug      String  @unique
  name      String
  city      String
  address   String  @db.VarChar(250)
  phone     String
  whatsapp  String?
  email     String?
  hours     String  @db.Text
  services  Json    @default("[]")
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)
}

model Setting {
  key       String   @id
  value     String   @db.LongText
  group     String   @default("general")
  label     String?
  updatedAt DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique @db.VarChar(254)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String        @db.VarChar(254)
  phone     String?
  subject   String        @db.VarChar(250)
  message   String        @db.Text
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())

  @@index([status, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  actorEmail String?  @db.VarChar(254)
  action     String   @db.VarChar(100)
  entityType String   @db.VarChar(100)
  entityId   String?  @db.VarChar(191)
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
}

// Transaction-scoped InnoDB mutex shared by optical reviews and checkout.
// The singleton row is installed by the initial MariaDB migration.
model DatabaseMutex {
  id String @id @db.VarChar(64)
}
