# Copy values into Hostinger hPanel Environment variables. Never commit real values.
# Hostinger injects configured variables into build and runtime; NEXT_PUBLIC_* values
# are embedded in the browser bundle during build and must be set before deployment.

# APPLICATION — runtime required
NODE_ENV=production
# staging adds X-Robots-Tag noindex; production allows indexing
APP_ENVIRONMENT=production
NEXT_PUBLIC_SITE_URL=https://agharasvision.com
NEXT_PUBLIC_WHATSAPP_NUMBER=<business-whatsapp-number>
NEXT_PUBLIC_CONTACT_EMAIL=<public-contact-email>

# DATABASE — runtime required. Create the database/user in Hostinger hPanel first.
# Substitute the exact prefixed host/name/user shown by hPanel; percent-encode URL special characters.
DATABASE_URL=mysql://<database-user>:<url-encoded-password>@127.0.0.1:3306/<prefixed-database-name>?connection_limit=5&connect_timeout=15&pool_timeout=10

# AUTHENTICATION — runtime required
AUTH_SECRET=<unique-random-secret-at-least-32-bytes>
OWNER_EMAIL=<provisioned-owner-email>
# OWNER_PASSWORD is only for the one-time, controlled owner provisioning command;
# never configure it in the normal Hostinger application runtime.
# OWNER_PASSWORD=<one-time-owner-password>

# STORAGE — owner public catalogue/CMS media are stored as MariaDB BLOBs.
PUBLIC_MEDIA_STORAGE_DRIVER=mariadb
PUBLIC_MEDIA_MAX_TOTAL_BYTES=<integer-budget-confirmed-against-hostinger-db-quota>
# Private prescription documents still use the existing S3-compatible adapter.
OBJECT_STORAGE_DRIVER=s3
OBJECT_STORAGE_BUCKET=<private-bucket-name>
OBJECT_STORAGE_REGION=<provider-region>
# Optional; omit for AWS S3. If used, must be HTTPS (e.g. the approved S3-compatible endpoint).
OBJECT_STORAGE_ENDPOINT=<https-s3-compatible-endpoint-or-omit>
OBJECT_STORAGE_ACCESS_KEY_ID=<server-side-access-key>
OBJECT_STORAGE_SECRET_ACCESS_KEY=<server-side-secret-key>
# Filesystem paths are not used for MariaDB public media. Do not configure a
# prescription filesystem path unless Hostinger verifies a private persistent volume.

# EMAIL — production requires a configured SMTP mailbox.
# For a staging site without real sends, set APP_ENVIRONMENT=staging and EMAIL_TRANSPORT=discard.
EMAIL_TRANSPORT=smtp
EMAIL_FROM=<approved-sender-address>
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_USER=<smtp-user>
SMTP_PASSWORD=<smtp-password>

# CRON — runtime; generate a separate random secret and keep it server-side
CRON_SECRET=<unique-random-cron-secret-at-least-32-bytes>

# LOGGING — no project-specific log-level or external logging variable exists.
# Hostinger Runtime Logs collect sanitized JSON diagnostics from stdout/stderr.

# TESTS / LOCAL ADMIN — optional, never configure on the production website
TEST_DATABASE_URL=mysql://<test-user>:<url-encoded-password>@127.0.0.1:3306/<isolated-test-database>?connection_limit=5
ALLOW_TEST_SEED_RESET=0
SEED_ADMIN_EMAIL=<local-test-only>
SEED_ADMIN_PASSWORD=<local-test-only>
SEED_STAFF_EMAIL=<local-test-only>
SEED_STAFF_PASSWORD=<local-test-only>
SEED_CUSTOMER_EMAIL=<local-test-only>
SEED_CUSTOMER_PASSWORD=<local-test-only>
# Optional one-time owner provisioning names (not runtime secrets).
# OWNER_FIRST_NAME=<owner-first-name>
# OWNER_LAST_NAME=<owner-last-name>

# MIGRATION GUARD — set only in a short-lived controlled migration shell after
# verifying a backup OR confirming the target database is intentionally empty.
# Never leave these variables in the running web app.
# MIGRATION_EXPECTED_DATABASE=<exact-database-name>
# MIGRATION_CONFIRM_TARGET=<exact-database-name>
# MIGRATION_BACKUP_VERIFIED=true
# MIGRATION_TARGET_EMPTY_CONFIRMED=true

# NODE_ENV, NEXT_RUNTIME, PORT, and NEXT_DIST_DIR are provided/managed by the runtime
# or are local build controls. Do not set NEXT_DIST_DIR on Hostinger.
